# ---------- Supabase (obrigatório) ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Service role: usada só no servidor, pelo webhook do Stripe e pela devolução
# de quota quando a IA falha. NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- IA (obrigatório para gerar material) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Stripe (opcional: sem isso todos ficam no plano gratuito) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ESCOLA=
